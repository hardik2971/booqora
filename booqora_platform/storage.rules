rules_version = '2';

// Workspace media (product images, logos) are publicly readable so the
// storefront can display them. Uploads require a signed-in (non-anonymous)
// account, must be images/PDFs under 10 MB, are stamped with the uploader's uid,
// and can never overwrite or delete someone else's file.
service firebase.storage {
  match /b/{bucket}/o {
    function staff() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function validUpload(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }
    function ownsExisting() {
      return resource == null || resource.metadata.uploadedBy == request.auth.uid;
    }

    match /workspaces/{wid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if staff() && validUpload(10) && ownsExisting();
      allow delete: if staff() && resource.metadata.uploadedBy == request.auth.uid;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
